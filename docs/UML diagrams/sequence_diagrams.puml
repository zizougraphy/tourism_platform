' ╔══════════════════════════════════════════════════════════╗
' ║  DIAGRAM 6 — Provider Registration + Admin Approval      ║
' ╚══════════════════════════════════════════════════════════╝

title Diagram 6 — Provider Registration & Admin Approval

actor       "Provider"    as P
actor       "Admin"       as A
participant "Frontend"    as FE
participant "Backend"     as BE
participant "Database"    as DB
participant "Notification\nService" as NS

P  -> FE  : fill provider registration form\n(name, email, password,\nbusiness name, phone)
activate FE

FE -> BE  : POST /auth/register\n{ ...fields, role: SERVICE_PROVIDER }
activate BE

BE -> DB  : SELECT user WHERE email = ?
activate DB
DB --> BE : result
deactivate DB

alt [email already taken]
  BE --> FE : 409 — email already in use
  FE --> P  : show error message

else [email free]
  BE -> DB  : INSERT User { role: SERVICE_PROVIDER,\nisActive: false }
  activate DB
  DB --> BE : userId
  deactivate DB

  BE -> NS  : notify all admins\n"New provider awaiting approval"
  activate NS
  NS -> DB  : INSERT Notification { userId: adminId }
  activate DB
  DB --> NS : ok
  deactivate DB
  NS --> BE : ok
  deactivate NS

  BE --> FE : 201 — registration received,\npending admin approval
  FE --> P  : show "your account is under review"
end

deactivate BE
deactivate FE

note over A : Admin reviews pending\nprovider accounts\nin the dashboard

A  -> FE  : open pending providers list
activate FE

FE -> BE  : GET /admin/providers?status=pending\n{ adminToken }
activate BE

BE -> DB  : SELECT users WHERE role = SERVICE_PROVIDER\nAND isActive = false
activate DB
DB --> BE : list of pending providers
deactivate DB

BE --> FE : 200 — { providers[] }
FE --> A  : display providers list

A  -> FE  : click Approve or Reject on a provider
activate FE

alt [Admin approves]
  FE -> BE  : PATCH /admin/providers/:id/approve\n{ adminToken }
  activate BE

  BE -> DB  : UPDATE User SET isActive = true
  activate DB
  DB --> BE : ok
  deactivate DB

  BE -> NS  : notify provider\n"Your account has been approved"
  activate NS
  NS -> DB  : INSERT Notification { userId: providerId }
  activate DB
  DB --> NS : ok
  deactivate DB
  NS --> BE : ok
  deactivate NS

  BE --> FE : 200 — provider approved
  FE --> A  : update list

  note over P : Provider receives\nnotification and\ncan now log in

else [Admin rejects]
  FE -> BE  : PATCH /admin/providers/:id/reject\n{ adminToken }
  activate BE

  BE -> DB  : DELETE User WHERE id = providerId
  activate DB
  DB --> BE : ok
  deactivate DB

  BE -> NS  : notify provider\n"Your registration was rejected"
  activate NS
  NS -> DB  : INSERT Notification { userId: providerId }
  activate DB
  DB --> NS : ok
  deactivate DB
  NS --> BE : ok
  deactivate NS

  BE --> FE : 200 — provider rejected
  FE --> A  : update list
  deactivate BE
end

deactivate BE
deactivate FE

@enduml

@startuml tourism_sequence_diagrams

' ============================================================
'  Theme: Soft Purples & Violets
' ============================================================
skinparam backgroundColor #F7F5FF
skinparam shadowing false
skinparam roundcorner 8

skinparam participant {
  BackgroundColor #EDE9FF
  BorderColor #7C5CBF
  FontColor #2E1A47
  FontSize 13
  FontStyle bold
}

skinparam actor {
  BackgroundColor #EDE9FF
  BorderColor #7C5CBF
  FontColor #2E1A47
  FontSize 12
  FontStyle bold
}

skinparam sequence {
  ArrowColor #7C5CBF
  ArrowThickness 1.3
  LifeLineBorderColor #9B7FD4
  LifeLineBackgroundColor #F3F0FF
  BoxBackgroundColor #F3F0FF
  BoxBorderColor #6A3FA6
  DividerBackgroundColor #EDE9FF
  DividerBorderColor #7C5CBF
  GroupBackgroundColor #F7F5FF
  GroupBorderColor #7C5CBF
  GroupHeaderFontColor #6A3FA6
  GroupFontColor #2E1A47
  NoteBackgroundColor #EDE9FF
  NoteBorderColor #7C5CBF
  NoteFontColor #2E1A47
}

skinparam activationBorderColor #6A3FA6
skinparam activationBackgroundColor #D5CCFF

' ╔══════════════════════════════════════════════════════════╗
' ║  DIAGRAM 1 — Tourist Login                               ║
' ╚══════════════════════════════════════════════════════════╝

title Diagram 1 — Tourist Login

actor       "Tourist"     as T
participant "Frontend"    as FE
participant "Backend"     as BE
participant "Database"    as DB

T  -> FE  : enter email & password
activate FE

FE -> BE  : POST /auth/login { email, password }
activate BE

BE -> DB  : SELECT user WHERE email = ?
activate DB
DB --> BE : user record
deactivate DB

alt [user not found]
  BE --> FE : 404 — user not found
  FE --> T  : show "account does not exist"

else [password incorrect]
  BE --> FE : 401 — invalid credentials
  FE --> T  : show "wrong password"

else [account inactive]
  BE --> FE : 403 — account suspended
  FE --> T  : show "account suspended"

else [credentials valid]
  BE -> BE  : generate JWT token
  BE --> FE : 200 — { token, user: { id, name, role } }
  FE -> FE  : store token in localStorage
  FE --> T  : redirect to home dashboard
end

deactivate BE
deactivate FE

' ══════════════════════════════════════════════════════════
newpage
' ══════════════════════════════════════════════════════════

' ╔══════════════════════════════════════════════════════════╗
' ║  DIAGRAM 2 — Tourist Registration                        ║
' ╚══════════════════════════════════════════════════════════╝

title Diagram 2 — Tourist Registration

actor       "Tourist"     as T
participant "Frontend"    as FE
participant "Backend"     as BE
participant "Database"    as DB

T  -> FE  : fill registration form\n(name, email, password, phone)
activate FE

FE -> FE  : validate form fields

alt [form has errors]
  FE --> T : show validation errors
else [form is valid]

  FE -> BE  : POST /auth/register { name, email, password, phone }
  activate BE

  BE -> DB  : SELECT user WHERE email = ?
  activate DB
  DB --> BE : result
  deactivate DB

  alt [email already exists]
    BE --> FE : 409 — email already taken
    FE --> T  : show "email already in use"

  else [email is free]
    BE -> BE  : hash password
    BE -> DB  : INSERT new User { role: TOURIST }
    activate DB
    DB --> BE : userId
    deactivate DB

    BE --> FE : 201 — { token, user: { id, name, role } }
    FE -> FE  : store token
    FE --> T  : redirect to home dashboard
  end

  deactivate BE
end

deactivate FE

' ══════════════════════════════════════════════════════════
newpage
' ══════════════════════════════════════════════════════════

' ╔══════════════════════════════════════════════════════════╗
' ║  DIAGRAM 3 — Search City & Filter Services               ║
' ╚══════════════════════════════════════════════════════════╝

title Diagram 3 — Search City & Filter Services

actor       "Tourist"     as T
participant "Frontend"    as FE
participant "Backend"     as BE
participant "Database"    as DB

' ── Phase 1: Tourist types city name ────────────────────

T  -> FE  : type city name in search bar\n(e.g. "Algiers")
activate FE

FE -> BE  : GET /cities?name=Algiers
activate BE

BE -> DB  : SELECT city WHERE name LIKE 'Algiers'
activate DB
DB --> BE : city record { id, name, country, description }
deactivate DB

alt [city not found]
  BE --> FE : 404 — city not found
  FE --> T  : show "no city matches your search"

else [city found]
  BE --> FE : 200 — { city }
  FE --> T  : display city info page\n(name, description, weather)

  ' ── Phase 2: Load all services of that city ───────────

  FE -> BE  : GET /services?cityId=1
  activate BE

  BE -> DB  : SELECT services WHERE cityId = 1
  activate DB
  DB --> BE : all services in city
  deactivate DB

  BE --> FE : 200 — { services[] }
  FE --> T  : display all services\nas a list with category buttons:\n[All] [Hotel] [Restaurant] [Tour] [Activity] ...
  deactivate BE

  ' ── Phase 3: Tourist clicks a category button ─────────

  opt [tourist clicks a category button]
    T  -> FE  : click category button\n(e.g. "Hotel")
    FE -> BE  : GET /services?cityId=1&category=Hotel
    activate BE

    BE -> DB  : SELECT services WHERE cityId = 1\nAND category = 'Hotel'
    activate DB
    DB --> BE : filtered services
    deactivate DB

    BE --> FE : 200 — { services[] }
    FE --> T  : update list — show only Hotels
    deactivate BE
  end

  ' ── Phase 4: Tourist applies extra filters ────────────

  opt [tourist applies extra filters]
    T  -> FE  : set price range and/or rating\n(e.g. max 5000 DZD, rating >= 4)
    FE -> BE  : GET /services?cityId=1&category=Hotel\n&maxPrice=5000&rating=4
    activate BE

    BE -> DB  : SELECT services WHERE cityId = 1\nAND category = 'Hotel'\nAND price <= 5000\nAND rating >= 4
    activate DB
    DB --> BE : filtered services
    deactivate DB

    BE --> FE : 200 — { services[] }
    FE --> T  : update list with refined results
    deactivate BE
  end

  ' ── Phase 5: Tourist clicks a specific service ────────

  opt [tourist clicks on a service]
    T  -> FE  : click on a service card
    FE -> BE  : GET /services/:id
    activate BE

    BE -> DB  : SELECT service + reviews + availability
    activate DB
    DB --> BE : service full details
    deactivate DB

    BE --> FE : 200 — { service, reviews[], availability[] }
    FE --> T  : display service detail page
    deactivate BE
  end

end

deactivate FE


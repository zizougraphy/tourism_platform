' ══════════════════════════════════════════════════════════

' ╔══════════════════════════════════════════════════════════╗
' ║  DIAGRAM 5 — Leave a Review                              ║
' ╚══════════════════════════════════════════════════════════╝

title Diagram 5 — Leave a Review

actor       "Tourist"     as T
participant "Frontend"    as FE
participant "Backend"     as BE
participant "Database"    as DB

T  -> FE  : click "Write a Review"\non completed booking
activate FE

FE -> BE  : GET /bookings/:id/can-review\n{ token }
activate BE

BE -> DB  : SELECT booking WHERE id AND touristId\nAND status = COMPLETED
activate DB
DB --> BE : booking record
deactivate DB

alt [booking not found or not completed]
  BE --> FE : 403 — review not allowed
  FE --> T  : show "you can only review\nservices you have completed"

else [booking exists and is completed]
  BE -> DB  : SELECT review WHERE bookingId
  activate DB
  DB --> BE : existing review or null
  deactivate DB

  alt [review already submitted]
    BE --> FE : 409 — already reviewed
    FE --> T  : show "you already reviewed this service"

  else [no review yet]
    BE --> FE : 200 — review form allowed
    FE --> T  : display review form\n(rating 1–5, comment)

    T  -> FE  : submit rating & comment
    FE -> BE  : POST /reviews\n{ serviceId, bookingId, rating, comment, token }
    activate BE

    BE -> DB  : INSERT Review { rating, comment, date }
    activate DB
    DB --> BE : reviewId
    deactivate DB

    BE -> DB  : UPDATE Service\nSET rating = AVG(all ratings)
    activate DB
    DB --> BE : ok
    deactivate DB

    BE --> FE : 201 — review saved
    FE --> T  : show "thank you for your review!"
    deactivate BE
  end

end

deactivate BE
deactivate FE


' ╔══════════════════════════════════════════════════════════╗
' ║  DIAGRAM 4 — Make a Reservation                          ║
' ╚══════════════════════════════════════════════════════════╝

title Diagram 4 — Make a Reservation

actor       "Tourist"        as T
participant "Frontend"       as FE
participant "Backend"        as BE
participant "Database"       as DB
participant "Notification\nService" as NS

T  -> FE  : select check-in & check-out dates\nthen click "Book Now"
activate FE

FE -> BE  : POST /bookings\n{ serviceId, checkIn, checkOut, token }
activate BE

BE -> BE  : verify JWT token

alt [token invalid / expired]
  BE --> FE : 401 — unauthorized
  FE --> T  : redirect to login page

else [token valid]

  BE -> DB  : SELECT availability WHERE serviceId AND date range
  activate DB
  DB --> BE : availability slots
  deactivate DB

  alt [no slots available]
    BE --> FE : 409 — service not available for selected dates
    FE --> T  : show "no availability for these dates"

  else [slots available]
    BE -> DB  : INSERT Booking { status: PENDING }
    activate DB
    DB --> BE : bookingId
    deactivate DB

    BE -> DB  : UPDATE Availability\nSET bookedSlots = bookedSlots + 1
    activate DB
    DB --> BE : ok
    deactivate DB

    BE -> NS  : sendNotification(touristId,\n"Booking confirmed — #bookingId")
    activate NS
    NS -> DB  : INSERT Notification { userId: tourist }
    activate DB
    DB --> NS : ok
    deactivate DB
    NS --> BE : ok
    deactivate NS

    BE -> NS  : sendNotification(providerId,\n"New booking received")
    activate NS
    NS -> DB  : INSERT Notification { userId: provider }
    activate DB
    DB --> NS : ok
    deactivate DB
    NS --> BE : ok
    deactivate NS

    BE --> FE : 201 — { booking: { id, status, totalPrice } }
    FE --> T  : show booking confirmation page
  end

end

deactivate BE
deactivate FE

